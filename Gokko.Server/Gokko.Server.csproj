<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gokko.Server</RootNamespace>
    <AssemblyName>Gokko.Server</AssemblyName>

    <!-- 1GB のサーバー向け: メモリを多く確保するサーバーGCを使わない -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gokko.Common\Gokko.Common.csproj" />
  </ItemGroup>

  <!-- データファイルは exe の隣の Data フォルダに置く（サーバー上で書き換えて再起動すれば反映される） -->
  <ItemGroup>
    <Content Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 踏切の閉塞。特発の復帰を、列車のいる閉塞で判定する -->
    <Content Include="Data\CrossingBlocks.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 行路表。勤怠管理の画面で Duties*.csv から選んで読む（既定は Duties.csv。Duties.full.csv は館浜〜大路の本来の行路） -->
    <Content Include="Data\Duties.csv;Data\Duties.full.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 運行番号ごとの両数。スプレッドシートから書き出した CSV をそのまま置く（見出しの「運行番号」「両数」の列だけ読む） -->
    <Content Include="Data\UnyoCars.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 列番ごとの両数（運行の両数より優先。運転区間の外で連結・解放して両数が変わる列車） -->
    <Content Include="Data\TrainCars.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 停止位置目標（上り・下り）。ユーザーが作った CSV をそのまま置く（見出しの距離と、各距離にある停目の両数） -->
    <Content Include="Data\StopMarkers.up.csv;Data\StopMarkers.down.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 管理画面。exe の場所を基準に読むので、dotnet build の出力にもコピーする -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- Crew.db の接続・スキーマ作成・トランザクションに使用 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
