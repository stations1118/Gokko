<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gokko.Tests</RootNamespace>
    <AssemblyName>Gokko.Tests</AssemblyName>
  </PropertyGroup>

  <!-- クライアントの自動運転（AutoDriver.cs・StopDistance.cs）を、そのまま取り込んで確かめる（ClientCheck.cs）。
       クライアントは Windows 用なので参照せず、ファイルだけ取り込む。TrainCrewInput.dll は列車の状態の型として使うだけ（ゲームは呼ばない） -->
  <ItemGroup>
    <Compile Include="..\Gokko.Client\StopDistance.cs" Link="Client\StopDistance.cs" />
    <Compile Include="..\Gokko.Client\AutoDriver.cs" Link="Client\AutoDriver.cs" />
    <Compile Include="..\Gokko.Client\TciState.cs" Link="Client\TciState.cs" />
    <Reference Include="TrainCrewInput">
      <HintPath>..\Gokko.Client\lib\TrainCrewInput.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ゲームをつないだ列車の代わり（FakePlayer）が、クライアントと同じハブに報告を送るため -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <ProjectReference Include="..\Gokko.Common\Gokko.Common.csproj" />
  </ItemGroup>

</Project>
